generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  platform_admin
  institution_admin
  lab_admin
  superadmin
  admin
  student
}

enum BorrowStatus {
  pending
  approved
  rejected
  returned
  late
  damaged
  lost
}

enum InviteStatus {
  active
  revoked
  used
  expired
}

model User {
  id        Int           @id @default(autoincrement())
  name      String
  email     String        @unique
  password  String
  role      Role
  status    String        @default("active")
  institutionId Int?
  institution Institution? @relation(fields: [institutionId], references: [id])
  labId     Int?
  lab       Lab?          @relation(fields: [labId], references: [id])
  borrowings Borrowing[]
  createdInvites Invitation[] @relation("InvitationCreator")
  auditLogs AuditLog[]
  notifications Notification[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  @@index([status])
  @@index([institutionId])
  @@index([labId])
}

model Notification {
  id        Int      @id @default(autoincrement())
  institutionId Int?
  institution Institution? @relation(fields: [institutionId], references: [id])
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  dedupeKey String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  @@index([institutionId])
  @@index([userId])
  @@index([isRead])
  @@unique([userId, dedupeKey])
}

model Institution {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String   @unique
  status    String   @default("active")
  domain    String?
  registrationMode String @default("invite")
  labs      Lab[]
  users     User[]
  invitations Invitation[]
  notifications Notification[]
  auditLogs AuditLog[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status])
}

model Lab {
  id         Int         @id @default(autoincrement())
  institutionId Int
  institution Institution @relation(fields: [institutionId], references: [id])
  name       String
  location   String
  status     String      @default("active")
  users      User[]
  categories Category[]
  inventory  Inventory[]
  invitations Invitation[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  @@index([institutionId])
  @@index([status])
  @@unique([institutionId, name])
}

model Invitation {
  id        Int          @id @default(autoincrement())
  code      String       @unique
  inviteeEmail String?
  institutionId Int
  institution Institution @relation(fields: [institutionId], references: [id])
  labId     Int?
  lab       Lab?         @relation(fields: [labId], references: [id])
  role      Role         @default(student)
  status    InviteStatus @default(active)
  maxUses   Int          @default(1)
  usedCount Int          @default(0)
  expiresAt DateTime
  createdById Int
  createdBy User         @relation("InvitationCreator", fields: [createdById], references: [id])
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  @@index([institutionId])
  @@index([inviteeEmail])
  @@index([labId])
  @@index([status])
  @@index([expiresAt])
}

model Category {
  id        Int        @id @default(autoincrement())
  name      String
  labId     Int
  lab       Lab        @relation(fields: [labId], references: [id])
  inventory Inventory[]
}

model Inventory {
  id             Int         @id @default(autoincrement())
  name           String
  categoryId     Int
  category       Category    @relation(fields: [categoryId], references: [id])
  labId          Int
  lab            Lab         @relation(fields: [labId], references: [id])
  totalStock     Int
  availableStock Int
  minStock       Int         @default(0)
  location       String?
  condition      String?
  qrCodeUrl      String?
  borrowings     Borrowing[]
  createdAt      DateTime    @default(now())
  @@index([labId])
  @@index([categoryId])
  @@index([name])
}

model Borrowing {
  id          Int          @id @default(autoincrement())
  userId      Int
  user        User         @relation(fields: [userId], references: [id])
  inventoryId Int
  inventory   Inventory    @relation(fields: [inventoryId], references: [id])
  quantity    Int
  borrowDate  DateTime     @default(now())
  dueDate     DateTime
  returnDate  DateTime?
  status      BorrowStatus @default(pending)
  createdAt   DateTime     @default(now())
  @@index([status])
  @@index([dueDate])
  @@index([userId])
  @@index([inventoryId])
  @@index([borrowDate])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  institutionId Int?
  institution Institution? @relation(fields: [institutionId], references: [id])
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  Int
  details   Json?
  timestamp DateTime @default(now())
  @@index([institutionId])
  @@index([userId])
}
